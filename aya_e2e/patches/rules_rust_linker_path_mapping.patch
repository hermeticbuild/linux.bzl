diff --git a/test/unit/linker_path_mapping/linker_path_mapping_test.bzl b/test/unit/linker_path_mapping/linker_path_mapping_test.bzl
new file mode 100644
--- /dev/null
+++ b/test/unit/linker_path_mapping/linker_path_mapping_test.bzl
@@ -0,0 +1,115 @@
+"""Regressions for C/C++ paths carried through Rust linker arguments."""
+
+load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+
+# buildifier: disable=bzl-visibility
+load("//rust/private:rust_link_paths.bzl", "cc_link_argument_path", "cc_link_arguments_for_path_mapping")
+
+def _file(path, directory = False):
+    return struct(path = path, is_directory = directory)
+
+def _mapping_test_impl(ctx):
+    env = unittest.begin(ctx)
+    directory = _file("bazel-out/config/bin/runtime dir", True)
+    linker = _file("bazel-out/config/bin/linker")
+    original = [
+        linker.path,
+        "-L" + directory.path,
+        "-B" + directory.path,
+        "-resource-dir",
+        directory.path,
+        "--sysroot=" + directory.path,
+        directory.path + "/lib/subdir",
+        "--sysroot=/dev/null",
+        "-Wl,-z,relro,-z,now",
+        "-L/usr/lib",
+        "-L" + directory.path,
+    ]
+    arguments, safe = cc_link_arguments_for_path_mapping(original, [directory, linker], "bazel-out")
+    asserts.true(env, safe)
+    asserts.equals(env, original, [cc_link_argument_path(arg) for arg in arguments])
+
+    # Fake mapped Files test literal prefix/suffix reconstruction independently
+    # of the real execution test below. Source and ordering remain unchanged.
+    mapped = []
+    for arg in arguments:
+        if type(arg) == "string":
+            mapped.append(arg)
+        else:
+            prefix, file, suffix = arg
+            mapped.append(cc_link_argument_path((prefix, _file(file.path.replace("bazel-out/config/", "bazel-out/cfg/"), file.is_directory), suffix)))
+    asserts.equals(env, [arg.replace("bazel-out/config/", "bazel-out/cfg/") for arg in original], mapped)
+    return unittest.end(env)
+
+def _unrepresented_test_impl(ctx):
+    env = unittest.begin(ctx)
+    file = _file("bazel-out/config/bin/input")
+    directory = _file("bazel-out/config/bin/tree", True)
+    for argument in [
+        "-Lbazel-out/config/bin/input/sibling",
+        "-Lbazel-out/config/bin/tree-unrelated",
+        "-Lbazel-out/config/bin/tree/../sibling",
+        "-Lbazel-out/other/bin/missing",
+        "-Wl,--version-script=bazel-out/config/bin/input",
+        "-DNAME=bazel-out/config/bin/input",
+    ]:
+        actual, safe = cc_link_arguments_for_path_mapping([argument], [file, directory], "bazel-out")
+        asserts.false(env, safe)
+        asserts.equals(env, [argument], actual)
+    return unittest.end(env)
+
+def _unchanged_test_impl(ctx):
+    env = unittest.begin(ctx)
+    for original in [[], ["external/compiler/bin/cc", "-pthread", "-L/usr/lib", "-Wl,-rpath,$ORIGIN", "a value with spaces"]]:
+        actual, safe = cc_link_arguments_for_path_mapping(original, [], "bazel-out")
+        asserts.true(env, safe)
+        asserts.equals(env, original, actual)
+    return unittest.end(env)
+
+mapping_test = unittest.make(_mapping_test_impl)
+unrepresented_test = unittest.make(_unrepresented_test_impl)
+unchanged_test = unittest.make(_unchanged_test_impl)
+
+def _execution_test_impl(ctx):
+    directory = ctx.actions.declare_directory(ctx.label.name + ".runtime dir")
+    ctx.actions.run_shell(
+        outputs = [directory],
+        arguments = [directory.path],
+        command = "set -eu; printf input > \"$1/input\"",
+    )
+    output = ctx.actions.declare_file(ctx.label.name + ".checked")
+    arguments, safe = cc_link_arguments_for_path_mapping([
+        "-L" + directory.path,
+        "-B" + directory.path,
+        "-resource-dir",
+        directory.path,
+        "--sysroot=" + directory.path,
+        directory.path + "/input",
+    ], [directory], ctx.bin_dir.path.split("/", 1)[0])
+    if not safe:
+        fail("declared tree paths must remain mappable")
+    args = ctx.actions.args()
+    args.add_all([directory], expand_directories = False)
+    args.add(output)
+    args.add_all(arguments, map_each = cc_link_argument_path)
+    ctx.actions.run_shell(
+        inputs = [directory],
+        outputs = [output],
+        arguments = [args],
+        command = """set -eu
+test "$3" = "-L$1"
+test "$4" = "-B$1"
+test "$5" = "-resource-dir"
+test "$6" = "$1"
+test "$7" = "--sysroot=$1"
+test "$8" = "$1/input"
+test -f "$1/input"
+printf ok > "$2"
+""",
+        execution_requirements = {"supports-path-mapping": ""},
+    )
+    script = ctx.actions.declare_file(ctx.label.name + ".sh")
+    ctx.actions.write(script, "#!/bin/sh\nexit 0\n", is_executable = True)
+    return [DefaultInfo(executable = script, runfiles = ctx.runfiles(files = [output]))]
+
+execution_test = rule(implementation = _execution_test_impl, test = True)
