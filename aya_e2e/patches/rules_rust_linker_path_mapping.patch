diff --git a/rust/private/rust_link_paths.bzl b/rust/private/rust_link_paths.bzl
new file mode 100644
--- /dev/null
+++ b/rust/private/rust_link_paths.bzl
@@ -0,0 +1,63 @@
+"""Restore declared C/C++ linker paths before Args path mapping."""
+
+_JOINED_PATH_FLAGS = [
+    "--sysroot=",
+    "--gcc-toolchain=",
+    "--ld-path=",
+    "-resource-dir=",
+    "-fuse-ld=",
+    "-L",
+    "-B",
+]
+
+def _path_fragment(value, files_by_path):
+    file = files_by_path.get(value)
+    if file:
+        return (file, "")
+
+    # A member of a declared TreeArtifact is still an input under that exact
+    # tree. Never infer siblings or parent directories from one ordinary file.
+    pieces = value.split("/")
+    if "." in pieces or ".." in pieces:
+        return None
+    for length in range(len(pieces) - 1, 0, -1):
+        prefix = "/".join(pieces[:length])
+        file = files_by_path.get(prefix)
+        if file and file.is_directory:
+            return (file, value[len(prefix):])
+    return None
+
+def cc_link_arguments_for_path_mapping(arguments, linker_files, output_root):
+    """Returns File-backed linker operands and whether path mapping is safe.
+
+    Only exact selected linker inputs (or declared tree members) are recognized.
+    Unrepresentable output-root strings retain the original argument and make
+    this Rust action opt out; other actions and suite path mapping are unchanged.
+    """
+    files_by_path = {file.path: file for file in linker_files}
+    mapped = []
+    safe = True
+    for argument in arguments:
+        fragment = _path_fragment(argument, files_by_path)
+        prefix = ""
+        if fragment == None:
+            for candidate in _JOINED_PATH_FLAGS:
+                if argument.startswith(candidate):
+                    fragment = _path_fragment(argument[len(candidate):], files_by_path)
+                    if fragment != None:
+                        prefix = candidate
+                        break
+        if fragment != None:
+            mapped.append((prefix, fragment[0], fragment[1]))
+        else:
+            mapped.append(argument)
+            if output_root and output_root + "/" in argument:
+                safe = False
+    return mapped, safe
+
+def cc_link_argument_path(argument):
+    """Renders one operand at Args expansion, with Bazel's mapped File.path."""
+    if type(argument) == "string":
+        return argument
+    prefix, file, suffix = argument
+    return prefix + file.path + suffix
