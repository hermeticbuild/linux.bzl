@@ -0,0 +1,10 @@
+use nix::kmod::init_module;
+
+#[test_log::test]
+fn rust_module_exposes_btf() {
+    let module = std::fs::read("/aya_rust_btf.ko").unwrap();
+    init_module(&module, c"").unwrap();
+
+    let btf = std::fs::read("/sys/kernel/btf/aya_rust_btf").unwrap();
+    assert!(!btf.is_empty());
+}
