build --experimental_allow_map_directory
# Python entrypoints must use their declared runtime on bare Linux executors.
build --@rules_python//python/config_settings:bootstrap_impl=script
build --jobs=8

# Opt in to the public CI execution service used by upstream linux.bzl.
# Keep every output available for the qualification snapshots.
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --remote_cache=grpcs://remote.buildbuddy.io
build:remote --remote_header=x-buildbuddy-api-key=4jtaxdhxtyu4ylxdEwI7
build:remote --bes_backend=grpcs://remote.buildbuddy.io
build:remote --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote --remote_cache_compression
build:remote --remote_timeout=120
build:remote --grpc_keepalive_time=30s
build:remote --experimental_remote_execution_keepalive
build:remote --remote_download_outputs=all
build:remote --remote_default_exec_properties=OSFamily=Linux
build:remote --remote_default_exec_properties=Arch=amd64
build:remote --remote_default_exec_properties=container-image=docker://public.ecr.aws/docker/library/ubuntu@sha256:023f8a753c22258c9fe2d0005a7d28258038da7d620e9f93e9ad78aa266f9f11
build:remote --jobs=100

try-import %workspace%/.bazelrc.user
