load("@bazel_skylib//lib:shell.bzl", "shell")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//rules:compiler.bzl", "kernel_compiler")
load("//rules:compiler_test.bzl", "action_built_compiler", "action_built_toolchain_config")
load("//rules:config.bzl", "kernel_config")
load("//rules:configured.bzl", "configured_report")
load("//rules:kernel.bzl", "kernel_build")
load("//rules:validation.bzl", "execution_tool", "kernel_validation")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "validate_native_objects",
    build_setting_default = False,
)

exports_files([
    "MODULE.bazel",
    "llvm_toolchain_index.json",
    "test_config_values.py",
    "probe_runtime.py",
    "payload.py",
    "native_recipe.py",
    "qualification/native_recipe_check.py",
    "qualification/ir_diagnostics.py",
    "qualification/ir_diagnostics.c",
    "execute.py",
    "scheduler.py",
    "emit.py",
    "compare_kbuild.py",
    "launcher.c",
])

alias(
    name = "compiler",
    actual = "//native:compiler",
)

kernel_config(
    name = "config",
    fragments = ["//examples/configs:minimal.config"],
    pahole = "@pahole//:pahole",
    source = "//native:source",
    tags = ["manual"],
)

kernel_config(
    name = "allno_config",
    pahole = "@pahole//:pahole",
    requested = {"64BIT": "y"},
    source = "//native:source",
    tags = ["manual"],
)

alias(
    name = "custom_config",
    actual = "//native:custom_config",
)

kernel_build(
    name = "kernel",
    config = ":config",
    syntax = "@kernel_syntax//:program",
    tags = ["manual"],
)

[
    kernel_build(
        name = name,
        config = config,
        roots = ["lib/ctype.o"],
        syntax = syntax,
        tags = ["manual"],
    )
    for name, config, syntax in [
        ("native_compiler_checks", "//native:config", "@kernel_syntax//:program"),
        ("native_compiler_checks_5_10", "//native:old_config", "@kernel_syntax_5_10//:program"),
    ]
]

[
    kernel_config(
        name = name + "_config",
        fragments = [
            "//examples/configs:x86_64.config",
            "//examples/configs:btf.config",
        ],
        pahole = "@pahole//:pahole",
        source = source,
        tags = ["manual"],
    )
    for name, source in [
        ("native_btf_tools", "//native:source"),
        ("native_btf_tools_5_10", "//native:source_5_10"),
        ("native_btf_tools_6_18", "//native:source_6_18"),
    ]
]

[
    kernel_build(
        name = name,
        config = ":" + name + "_config",
        required_options = {"DEBUG_INFO_BTF": "y"},
        roots = ["tools/bpf/resolve_btfids/resolve_btfids"],
        syntax = syntax,
        tags = ["manual"],
    )
    for name, syntax in [
        ("native_btf_tools", "@kernel_syntax//:program"),
        ("native_btf_tools_5_10", "@kernel_syntax_5_10//:program"),
        ("native_btf_tools_6_18", "@kernel_syntax_6_18//:program"),
    ]
]

kernel_validation(
    name = "kernel_validation",
    kernel = ":kernel",
    tags = ["manual"],
)

build_test(
    name = "kernel_acceptance_test",
    tags = ["manual"],
    targets = [":kernel_validation"],
)

kernel_config(
    name = "debug_config",
    fragments = ["//examples/configs:minimal.config"],
    pahole = "@pahole//:pahole",
    requested = {
        "DEBUG_KERNEL": "y",
        "DEBUG_INFO_DWARF5": "y",
        "DEBUG_INFO_NONE": "n",
        "PRINTK_TIME": "y",
    },
    source = "//native:source",
    tags = ["manual"],
)

constraint_setting(name = "compiler_origin")

constraint_value(
    name = "action_built",
    constraint_setting = ":compiler_origin",
)

platform(
    name = "action_built_platform",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":action_built",
    ],
)

action_built_compiler(
    name = "compiler_driver",
    src = "//tests:compiler_driver.c",
    tags = ["manual"],
)

action_built_toolchain_config(
    name = "driver_toolchain_config",
    driver = ":compiler_driver",
    tags = ["manual"],
)

cc_toolchain(
    name = "driver_cc_toolchain",
    all_files = ":compiler_driver",
    ar_files = ":compiler_driver",
    as_files = ":compiler_driver",
    compiler_files = ":compiler_driver",
    dwp_files = ":compiler_driver",
    linker_files = ":compiler_driver",
    objcopy_files = ":compiler_driver",
    strip_files = ":compiler_driver",
    supports_param_files = 0,
    tags = ["manual"],
    toolchain_config = ":driver_toolchain_config",
    toolchain_identifier = "action-built-compiler-test",
)

toolchain(
    name = "driver_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = ["manual"],
    target_compatible_with = [
        ":action_built",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":driver_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

kernel_compiler(
    name = "driver_compiler",
    assembler_flags = ["-fintegrated-as"],
    builtin_headers = "//native:llvm_builtin_headers",
    tags = ["manual"],
    tools = {"@llvm//tools:llvm-readelf": "READELF"},
)

kernel_config(
    name = "action_built_config",
    compiler = ":driver_compiler",
    fragments = ["//examples/configs:x86_64.config"],
    pahole = "@pahole//:pahole",
    source = "//native:source",
    tags = ["manual"],
)

configured_report(
    name = "action_built_report",
    platform = ":action_built_platform",
    report = ":action_built_config",
    tags = ["manual"],
)

py_test(
    name = "action_built_config_test",
    srcs = ["test_config_values.py"],
    args = [
        "$(rootpath :action_built_report)",
        shell.quote(json.encode({
            "X86": "y",
            "64BIT": "y",
            "CC_IS_CLANG": "y",
            "CC_HAS_AUTO_VAR_INIT_PATTERN": "n",
        })),
        "--compiler-suffix=/compiler_driver",
    ],
    data = [":action_built_report"],
    main = "test_config_values.py",
    tags = ["manual"],
)

py_test(
    name = "execute_test",
    srcs = [
        "execute.py",
        "payload.py",
        "scheduler.py",
        "test_execute.py",
    ],
    main = "test_execute.py",
)

py_test(
    name = "generation_test",
    srcs = [
        "renderer/catalog.py",
        "renderer/compiler_queries.py",
        "renderer/export.py",
        "renderer/inputs.py",
        "renderer/programs.py",
        "renderer/syntax.py",
        "renderer/text_transforms.py",
        "test_generation.py",
    ],
    args = [
        "--make",
        "$(location //native:make_ast)",
    ],
    data = ["//native:make_ast"],
    imports = ["renderer"],
    main = "test_generation.py",
)

py_test(
    name = "probes_test",
    srcs = [
        "native_recipe.py",
        "payload.py",
        "probe_runtime.py",
        "test_probes.py",
    ],
    args = [
        "--compiler",
        "$(location @llvm//tools:clang)",
        "--shell",
        "$(location @kernel_exec_bash_linux_x86_64//file)",
    ],
    data = [
        "@kernel_exec_bash_linux_x86_64//file",
        "@llvm//tools:clang",
    ],
    main = "test_probes.py",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

py_test(
    name = "reuse_report_test",
    srcs = [
        "check_reuse.py",
        "test_reuse.py",
    ] + glob(["qualification/*.py"]),
    data = ["qualification/family_baseline.json"],
    main = "test_reuse.py",
)

py_binary(
    name = "ir_compare",
    srcs = [
        "qualification/ir_compare.py",
        "qualification/ir_reuse_report.py",
        "qualification/reuse_report.py",
    ],
    main = "qualification/ir_compare.py",
)

filegroup(
    name = "kbuild_exporter_sources",
    srcs = glob(["renderer/*.py"]),
)

execution_tool(
    name = "repository_test_make",
    testonly = True,
    tool = "@make",
)

[py_test(
    name = name,
    timeout = "long",
    srcs = [
        "build.py",
        "test_repository.py",
    ],
    args = [
        "--tool",
        "$(location //native:exporter)",
        "--source-anchor",
        "$(location @%s//:Makefile)" % source,
        "--make",
        "$(location :repository_test_make)",
    ],
    data = [
        ":repository_test_make",
        "//native:exporter",
        "@%s//:Makefile" % source,
        "@%s//:sources" % source,
    ],
    main = "test_repository.py",
    tags = ["manual"],
) for name, source in [("repository_test", "linux_source")] + [
    (
        "repository_%s_test" % line,
        "linux_" + line,
    )
    for line in [
        "5_10",
        "5_15",
        "6_1",
        "6_6",
        "6_12",
        "6_18",
    ]
]]

test_suite(
    name = "repository_tests",
    tags = ["manual"],
    tests = [":repository_test"] + [":repository_%s_test" % line for line in [
        "5_10",
        "5_15",
        "6_1",
        "6_6",
        "6_12",
        "6_18",
    ]],
)

py_test(
    name = "prototype_test",
    srcs = [
        "native_recipe.py",
        "prototype_test.py",
        "//examples:initramfs.py",
        "//native:configure.py",
        "//native:spec.py",
    ],
    args = [
        "--config-anchor",
        "$(rootpath //examples/configs:x86_64.config)",
    ],
    data = ["//examples/configs:" + name + ".config" for name in [
        "x86_64",
        "aarch64",
        "debug",
        "btf",
        "lz4",
    ]],
    imports = ["renderer"],
)

py_binary(
    name = "bootstrap_builder",
    srcs = ["build.py"],
    env = {"PYTHONDONTWRITEBYTECODE": "1"},
    main = "build.py",
    tags = ["manual"],
)
