load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["repository.bzl"])

filegroup(
    name = "generator_sources",
    srcs = [
        "build.py",
        "example.py",
        "launcher.c",
        "test_repository.py",
    ] + glob(
        [
            "native/**",
            "renderer/**",
        ],
        exclude = ["**/__pycache__/**"],
    ),
)

py_test(
    name = "prototype_test",
    srcs = [
        "prototype_test.py",
        "renderer/export.py",
        "renderer/repository_main.py",
    ],
    args = [
        "--initramfs",
        "$(rootpath @example_fixtures//:initramfs.py)",
        "--config-anchor",
        "$(rootpath @example_fixtures//configs:x86_64.config)",
    ],
    data = ["@example_fixtures//:initramfs.py"] + ["@example_fixtures//configs:" + name + ".config" for name in [
        "x86_64",
        "aarch64",
        "debug",
        "btf",
        "lz4",
    ]],
    imports = ["renderer"],
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "warn",
    lint_warnings = [
        "-module-docstring",
        "-function-docstring-args",
        "-function-docstring",
        "-function-docstring-header",
        "-function-docstring-return",
    ],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)
