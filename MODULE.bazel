module(
    name = "linux.bzl",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "autoconf.bzl", version = "0.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "gawk", version = "5.4.0.bcr.3")
bazel_dep(name = "grep", version = "3.12.bcr.1")
bazel_dep(name = "make", version = "4.4.1.bcr.2")
bazel_dep(name = "rules_bison", version = "0.4.bcr.1")
bazel_dep(name = "rules_flex", version = "0.4.1")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")
bazel_dep(name = "sed", version = "4.10.bcr.2")
bazel_dep(name = "elfutils", version = "0.195")
bazel_dep(name = "ape", version = "1.1.0")
bazel_dep(name = "lz4", version = "1.10.0.bcr.2")
bazel_dep(name = "rules_perl", version = "1.2.0")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "rules_bzip2", version = "1.0.0")
bazel_dep(name = "rules_xz", version = "1.0.1")

bazel_dep(name = "pahole", version = "1.31", dev_dependency = True)

git_override(
    module_name = "autoconf.bzl",
    commit = "08d970e04ac0592179d7b832e3189ae39a4e042c",
    remote = "https://github.com/hermeticbuild/autoconf.bzl.git",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.2.1.1", dev_dependency = True)

single_version_override(
    module_name = "make",
    patch_strip = 1,
    patches = ["//native:make_inputs.patch"],
)

make_ast_sources = use_repo_rule("//native:make_ast.bzl", "make_ast_sources")

make_ast_sources(
    name = "make_ast_sources",
    dev_dependency = True,
)

single_version_override(
    module_name = "rules_bison",
    patch_strip = 1,
    patches = ["//native:rules_bison_cstdlib.patch"],
)

single_version_override(
    module_name = "rules_cc_autoconf",
    patch_strip = 1,
    patches = [
        "//native:rules_cc_autoconf_no_host_shell.patch",
        "//native:rules_cc_autoconf_no_path_mapping.patch",
    ],
    version = "0.27.0",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "kernel_exec_bash_linux_x86_64",
    executable = True,
    sha256 = "64469a9512a00199c85622ec56f870f97d50457a4e06e0cfa39bae7adf0cc8f2",
    urls = ["https://github.com/robxu9/bash-static/releases/download/5.2.015-1.2.3-2/bash-linux-x86_64"],
)

http_file(
    name = "kernel_exec_busybox_linux_x86_64",
    executable = True,
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    urls = ["https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"],
)

register_toolchains(
    "@llvm//toolchain:all",
    "//execution_tools:linux_x86_64",
    "//native:static_musl_tests",
    "//native:static_musl_aarch64_tests",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(python_version = "3.13")

kernel_source_archive = use_repo_rule("//:repository.bzl", "kernel_source_archive")

kernel_source_archive(
    name = "linux_source",
    build_file = "//native:linux_source.BUILD.bazel",
    dev_dependency = True,
    integrity = "sha256-jrekIMzzqD8KL0yXrfTcfw5KvJjRDqVF0f2JE+qtXAU=",
    strip_prefix = "linux-0fcb05b72344f40806cbe810de8872f1698bf053",
    type = "tar.gz",
    urls = ["https://codeload.github.com/torvalds/linux/tar.gz/0fcb05b72344f40806cbe810de8872f1698bf053"],
)

kernel_source_archive(
    name = "linux_5_10",
    build_file = "//native:linux_source.BUILD.bazel",
    dev_dependency = True,
    integrity = "sha256-3nPVKLBL6R9uuGZgqmek1TuWu/ILtaMm54+ALXRN6+c=",
    strip_prefix = "linux-5.10.270",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v5.x/linux-5.10.270.tar.xz"],
)

kernel_source_archive(
    name = "linux_6_18",
    build_file = "//native:linux_source.BUILD.bazel",
    dev_dependency = True,
    integrity = "sha256-K2lWT31P6gyFmxlZujNwnubpE5vRAOMKhTtXFZqCIbg=",
    strip_prefix = "linux-6.18.52",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.52.tar.xz"],
)

# One generic host tool, bootstrapped from canonical Bazel outputs during development.
python_runtime = use_repo_rule("//native:repositories.bzl", "python_runtime_repository")

python_runtime(
    name = "bootstrap_python",
    dev_dependency = True,
    platform = "linux_x86_64_musl",
)

python_runtime(
    name = "bootstrap_python_macos",
    dev_dependency = True,
    platform = "macos_aarch64",
)

python_runtime(
    name = "bootstrap_python_linux_aarch64",
    dev_dependency = True,
    platform = "linux_aarch64_musl",
)

python_runtime(
    name = "bootstrap_python_macos_x86_64",
    dev_dependency = True,
    platform = "macos_x86_64",
)

kernel_syntax_tool = use_repo_rule("//:repository.bzl", "kernel_syntax_tool")

kernel_syntax_tool(
    name = "kbuild_exporter",
    dev_dependency = True,
)

kernel_syntax_repository = use_repo_rule("//:repository.bzl", "kernel_syntax_repository")

kernel_syntax_repository(
    name = "kernel_syntax",
    dev_dependency = True,
    source = "@linux_source//:Makefile",
    tool = "@kbuild_exporter//:kbuild-exporter",
)
