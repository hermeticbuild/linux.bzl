package(default_visibility = ["//visibility:public"])

# linux_source_repository replaces this marker with the exact files staged by
# source_overlays. Keep them explicit so directory symlinks and ordinary source
# globs have one deterministic ownership model. Exact BUILD and BUILD.bazel
# metadata files from overlays are intentionally absent.
_SOURCE_OVERLAY_FILES = [
    # __LINUX_BZL_SOURCE_OVERLAY_FILES__
]

# Preserve upstream paths in the logical source tree while keeping extracted
# files distinct on case-insensitive clients.
_RENAMED_SOURCE_PATHS = {
    # __LINUX_BZL_RENAMED_SOURCE_PATHS__
}

_SOURCE_DIRECTORIES = [
    # __LINUX_BZL_SOURCE_DIRECTORIES__
]

exports_files(
    glob(
        ["**"],
        exclude = _SOURCE_OVERLAY_FILES + _SOURCE_DIRECTORIES,
        exclude_directories = 0,
    ) + _SOURCE_OVERLAY_FILES,
    visibility = ["//visibility:public"],
)

# The Bazel 9 map_directory backend receives the complete immutable source
# tree and derives the selected Kconfig/Kbuild graph itself. No architecture-
# specific source inventory is mirrored in this repository template.
filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

# The repository rule prepends the canonical linux_source_runfiles load. One
# source-repository aggregate is shared by every image profile and family.
linux_source_runfiles(
    name = "linux_bzl_source_runfiles",
    source_files = [":all_files"],
    source_root = "Kconfig",
    renamed_paths = _RENAMED_SOURCE_PATHS,
)

# Public source-only aggregate used by rules_devicetree consumers. It does not
# duplicate any Kbuild selection policy.
filegroup(
    name = "dtb_sources",
    srcs = glob([
        "arch/*/boot/dts/**/*.dts",
        "arch/*/boot/dts/**/*.dtsi",
        "include/dt-bindings/**/*.h",
    ], allow_empty = True),
)
