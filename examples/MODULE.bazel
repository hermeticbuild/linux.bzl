module(
    name = "linux_bzl_examples",
    version = "0.0.0",
)

bazel_dep(name = "linux.bzl", version = "0.0.1")
bazel_dep(name = "llvm", version = "0.8.14")

# This override makes the example exercise the adjacent checkout. Remove it
# when consuming a published linux.bzl release.
local_path_override(
    module_name = "linux.bzl",
    path = "..",
)

register_toolchains(
    "@llvm//toolchain:all",
)

linux_source_repository = use_repo_rule(
    "@linux.bzl//:linux.bzl",
    "linux_source_repository",
)

linux_source_repository(
    name = "linux_6_18_39",
    version = "6.18.39",
)

linux_images = use_extension("@linux.bzl//:extensions.bzl", "linux_images")
linux_images.image(
    name = "example_x86_64",
    config = "//configs:x86_64.config",
    platform = "@llvm//platforms:linux_x86_64",
    source = "@linux_6_18_39//:Kconfig",
)
linux_images.overlay(
    name = "btf",
    config = "//configs:btf.config",
    image = "example_x86_64",
)
linux_images.overlay(
    name = "debug",
    config = "//configs:debug.config",
    image = "example_x86_64",
)
linux_images.overlay(
    name = "lz4",
    config = "//configs:lz4.config",
    image = "example_x86_64",
)
linux_images.overlay(
    name = "kvm",
    config = "//configs:kvm.config",
    image = "example_x86_64",
)
linux_images.overlay(
    name = "verity",
    config = "//configs:verity.config",
    image = "example_x86_64",
)
linux_images.image(
    name = "example_aarch64",
    config = "//configs:aarch64.config",
    platform = "@llvm//platforms:linux_arm64",
    source = "@linux_6_18_39//:Kconfig",
)
use_repo(
    linux_images,
    "example_aarch64",
    "example_x86_64",
)
