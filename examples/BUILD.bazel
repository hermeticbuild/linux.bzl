load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@linux.bzl", "initramfs")

package(default_visibility = ["//visibility:public"])

exports_files([
    "gcc_toolchain_remote_execution.patch",
    "libbpf_old_uapi_compat.patch",
    "llvm_kbuild_actions.patch",
])

string_flag(
    name = "compiler",
    build_setting_default = "clang",
    values = [
        "clang",
        "gcc",
    ],
)

config_setting(
    name = "gcc_selected",
    flag_values = {":compiler": "gcc"},
)

toolchain(
    name = "gcc_cc_toolchain_aarch64",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@example_gcc_aarch64//:_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

toolchain(
    name = "gcc_cc_toolchain_x86_64",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@example_gcc_x86_64//:_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

initramfs(
    name = "example_initramfs",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    directories = ["/proc"],
    files = {
        "/etc/motd": "README.md",
    },
)

alias(
    name = "x86_64_kernel",
    actual = "@example_x86_64//:kernel",
)

alias(
    name = "x86_64_debug_kernel",
    actual = "@example_x86_64//variants/debug:kernel",
)

alias(
    name = "x86_64_btf_vmlinux",
    actual = "@example_x86_64//variants/btf:vmlinux",
)

alias(
    name = "x86_64_lz4_kernel",
    actual = "@example_x86_64//variants/lz4:kernel",
)

alias(
    name = "aarch64_kernel",
    actual = "@example_aarch64//:kernel",
)
