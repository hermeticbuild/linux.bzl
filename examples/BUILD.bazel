load("@kernel_inputs//rules:qualification.bzl", "FRAGMENTS")
load("@rules_python//python:defs.bzl", "py_binary")
load(":kernel.bzl", "example_config_test", "example_initramfs", "kernel_example")

package(default_visibility = ["//visibility:public"])

exports_files(["initramfs.py"])

py_binary(
    name = "initramfs_writer",
    srcs = ["initramfs.py"],
    main = "initramfs.py",
)

example_initramfs(
    name = "example_initramfs",
    motd = "README.md",
)

[
    kernel_example(
        name = name,
        cc_toolchain = "@llvm//toolchain:linux_x86_64_to_linux_aarch64" if profile == "aarch64" else "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
        overrides = FRAGMENTS[profile] if profile not in [
            "x86_64",
            "aarch64",
        ] else {},
        platform = "@llvm//platforms:linux_aarch64" if profile == "aarch64" else "@llvm//platforms:linux_x86_64",
        requested = FRAGMENTS["aarch64"] if profile == "aarch64" else FRAGMENTS["x86_64"],
    )
    for name, profile in [
        ("x86_64_kernel", "x86_64"),
        ("x86_64_debug_kernel", "debug"),
        ("x86_64_lz4_kernel", "lz4"),
        ("x86_64_btf_vmlinux", "btf"),
        ("aarch64_kernel", "aarch64"),
    ]
]

filegroup(
    name = "x86_64_shared_graph_metadata",
    srcs = [":x86_64_kernel"],
    tags = ["manual"],
)

example_config_test(
    name = "x86_64_config_test",
    config = ":x86_64_kernel_config",
    expected = {
        "X86": "y",
        "64BIT": "y",
        "MODULES": "n",
    },
)

example_config_test(
    name = "aarch64_config_test",
    config = ":aarch64_kernel_config",
    expected = {
        "ARM64": "y",
        "64BIT": "y",
        "MODULES": "n",
    },
)

example_config_test(
    name = "debug_config_test",
    config = ":x86_64_debug_kernel_config",
    expected = {
        "DEBUG_KERNEL": "y",
        "LOCALVERSION": '\"-debug\"',
        "RANDOMIZE_BASE": "n",
    },
)

example_config_test(
    name = "lz4_config_test",
    config = ":x86_64_lz4_kernel_config",
    expected = {
        "KERNEL_LZ4": "y",
        "KERNEL_GZIP": "n",
    },
)

alias(
    name = "btf_capability_test",
    actual = "//:parity_btf_test",
)
