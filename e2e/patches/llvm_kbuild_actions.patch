+        for scope in ["host", "target"]
+        for role in [
+            "ar", "as", "cc", "cxx", "ld", "nm", "objcopy",
+            "objdump", "ranlib", "readelf", "strip",
+        ]
+    ],
+    args = ["__LINUX_BZL_KBUILD_ARGS_V1__"],
