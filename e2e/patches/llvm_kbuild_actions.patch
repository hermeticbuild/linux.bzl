diff --git a/toolchain/kbuild.bzl b/toolchain/kbuild.bzl
new file mode 100644
--- /dev/null
+++ b/toolchain/kbuild.bzl
@@ -0,0 +1,21 @@
+"""Kbuild action names and executable basenames shared by LLVM toolchains."""
+
+KBUILD_TOOLS = {
+    "linux_kbuild_" + scope + "_" + role: tool
+    for scope in ["host", "target"]
+    for role, tool in {
+        "ar": "llvm-ar",
+        "as": "clang",
+        "cc": "clang",
+        "cxx": "clang++",
+        "ld": "ld.lld",
+        "nm": "llvm-nm",
+        "objcopy": "llvm-objcopy",
+        "objdump": "llvm-objdump",
+        "ranlib": "llvm-ranlib",
+        "readelf": "llvm-readelf",
+        "strip": "llvm-strip",
+    }.items()
+}
+
+KBUILD_BINARIES = sorted({tool: None for tool in KBUILD_TOOLS.values()})
