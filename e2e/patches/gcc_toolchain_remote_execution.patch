+    for link_action in base_link_actions:
+        action_configs.append(action_config(
+            action_name = link_action,
+            enabled = True,
+            tools = [tool(path = tool_paths.get("g++"))],
+        ))
+
     action_configs.append(action_config(
         action_name = "objcopy_embed_data",
