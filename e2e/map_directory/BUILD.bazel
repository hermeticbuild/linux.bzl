load("@bazel_skylib//rules:build_test.bzl", "build_test")
load(
    "@linux.bzl//internal:map_directory_kconfig.bzl",
    "linux_map_directory_kconfig_spike",
    "linux_upstream_kconfig",
)
load("@rules_go//go:def.bzl", "go_binary")

package(default_visibility = ["//visibility:public"])

go_binary(
    name = "upstream_validator",
    srcs = ["upstream_validator.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/e2e/map_directory/upstream_validator",
    pure = "on",
)

linux_map_directory_kconfig_spike(
    name = "compiler_capabilities",
    srcs = [
        "assembly_selected.S",
        "clang_selected.c",
        "composite_first.c",
        "composite_second.c",
        "gcc_selected.c",
        "include/linux/compiler-version.h",
        "include/linux/compiler_types.h",
        "include/linux/kconfig.h",
        "required_local_header.h",
        "supported.c",
        "unsupported.c",
    ],
    config = "base.config",
    kbuild = "Kbuild",
    kconfig = "Kconfig",
    tags = ["requires-bazel-9"],
    validator = "@linux.bzl//internal/cmd/mapdirectoryvalidator",
)

linux_upstream_kconfig(
    name = "upstream_kconfig",
    config = "@e2e_linux_6_18_39//:arch/x86/configs/x86_64_defconfig",
    kconfig = "@e2e_linux_6_18_39//:Kconfig",
    kconfig_files = "@e2e_linux_6_18_39//:kconfig_files",
    tags = ["requires-bazel-9"],
    validator = ":upstream_validator",
)

build_test(
    name = "compiler_capabilities_e2e_test",
    tags = ["requires-bazel-9"],
    targets = [":compiler_capabilities"],
)

build_test(
    name = "upstream_kconfig_e2e_test",
    tags = ["requires-bazel-9"],
    targets = [":upstream_kconfig"],
)

test_suite(
    name = "compiler_kconfig_e2e_tests",
    tests = [
        ":compiler_capabilities_e2e_test",
        ":upstream_kconfig_e2e_test",
    ],
)
