module(
    name = "linux_bzl_e2e",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "linux.bzl", version = "0.1.0", repo_name = "kernel_rules")
bazel_dep(name = "llvm", version = "0.8.3", repo_name = "hermetic_llvm")

register_toolchains("@hermetic_llvm//toolchain:all")

local_path_override(
    module_name = "linux.bzl",
    path = "..",
)

linux_source_repository = use_repo_rule(
    "@kernel_rules//:linux.bzl",
    "linux_source_repository",
)

linux_source_repository(
    name = "e2e_linux_6_12_96",
    version = "6.12.96",
)

linux_source_repository(
    name = "e2e_linux_6_18_39",
    version = "6.18.39",
)

linux_image = use_repo_rule(
    "@kernel_rules//:linux.bzl",
    "linux_image",
)

linux_image(
    name = "e2e_6_12_96_x86_64",
    config = "//:tiny.config",
    platform = "@hermetic_llvm//platforms:linux_x86_64",
    source = "@e2e_linux_6_12_96//:Kconfig",
)

linux_image(
    name = "e2e_6_12_96_aarch64",
    config = "//:tiny_arm64.config",
    platform = "@hermetic_llvm//platforms:linux_arm64",
    source = "@e2e_linux_6_12_96//:Kconfig",
)

linux_image(
    name = "e2e_x86_64",
    config = "//:tiny.config",
    platform = "@hermetic_llvm//platforms:linux_x86_64",
    source = "@e2e_linux_6_18_39//:Kconfig",
)

linux_image(
    name = "e2e_aarch64",
    config = "//:tiny_arm64.config",
    platform = "@hermetic_llvm//platforms:linux_arm64",
    source = "@e2e_linux_6_18_39//:Kconfig",
)
