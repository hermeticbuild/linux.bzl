load("@linux.bzl//:linux.bzl", "linux")

package(default_visibility = ["//visibility:public"])

exports_files([
    "tiny.config",
    "tiny_arm64.config",
])

linux(
    name = "kernel",
    compact_repos = {
        "x86_64": "@tiny_compact",
