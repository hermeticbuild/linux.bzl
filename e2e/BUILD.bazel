qemu_boot_test(
    name = "linux_6_18_39_rust_module_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    expect = "LINUX_BZL_MODULE_LOAD_OK",
    initramfs = ":initramfs_6_18_39_rust_module",
