linux_cc_module(
    name = "hello_c_module",
    srcs = ["hello_module.c"],
    hdrs = [
        "external_module_headers/linux_bzl_external_closure.h",
        "external_module_headers/linux_bzl_from_kbuild_extmod.h",
        "external_module_headers/linux_bzl_from_m.h",
    ],
    # Recursive Kbuild keeps M in MAKEOVERRIDES while the root Makefile exports
    # its derived KBUILD_EXTMOD value to the compiler child.
    copts = [
        "-DLINUX_BZL_EXTERNAL_E2E",
        "$(if $(filter command line,$(origin M)),-DLINUX_BZL_M_ORIGIN_OK,-DLINUX_BZL_M_ORIGIN_BAD)",
        "$(if $(filter environment,$(origin KBUILD_EXTMOD)),-DLINUX_BZL_KBUILD_EXTMOD_ORIGIN_OK,-DLINUX_BZL_KBUILD_EXTMOD_ORIGIN_BAD)",
        "-include$(M)/external_module_headers/linux_bzl_from_m.h",
        "-include$(KBUILD_EXTMOD)/external_module_headers/linux_bzl_from_kbuild_extmod.h",
    ],
    kernel = "@e2e_x86_64//:kernel",
)

