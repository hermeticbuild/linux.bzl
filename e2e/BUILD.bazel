    name = "linux_6_18_39_x86_64_module_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    expect = "LINUX_BZL_MODULE_LOAD_OK",
    initramfs = ":initramfs_6_18_39_x86_64_module",
    kernel = "@e2e_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
