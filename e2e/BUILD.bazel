    size = "large",
    timeout = "long",
    arch = "aarch64",
    initramfs = ":initramfs_aarch64",
    kernel = "@e2e_aarch64//:kernel",
    kernel_args = [
        "console=ttyAMA0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
