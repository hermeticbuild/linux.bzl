alias(
    name = "kernel_image_aarch64",
    actual = "@e2e_aarch64//:image",
)

alias(
    name = "kernel_vmlinux_aarch64",
    actual = "@e2e_aarch64//:vmlinux",
)

alias(
    name = "kernel_image_x86_64",
    actual = "@e2e_x86_64//:image",
)

alias(
    name = "kernel_vmlinux_x86_64",
    actual = "@e2e_x86_64//:vmlinux",
)

build_test(
    name = "kernel_outputs_aarch64_build_test",
    targets = [
        "@e2e_aarch64//:config",
        "@e2e_aarch64//:kernel",
        "@e2e_aarch64//:kernel_release",
        "@e2e_aarch64//:module_symvers",
        "@e2e_aarch64//:modules",
        "@e2e_aarch64//:modules_builtin",
        "@e2e_aarch64//:modules_builtin_modinfo",
        "@e2e_aarch64//:modules_order",
        "@e2e_aarch64//:system_map",
        ":kernel_image_aarch64",
        ":kernel_vmlinux_aarch64",
    ],
)

build_test(
    name = "kernel_outputs_x86_64_build_test",
    targets = [
        "@e2e_x86_64//:config",
        "@e2e_x86_64//:kernel",
        "@e2e_x86_64//:kernel_release",
        "@e2e_x86_64//:module_symvers",
        "@e2e_x86_64//:modules",
        "@e2e_x86_64//:modules_builtin",
        "@e2e_x86_64//:modules_builtin_modinfo",
        "@e2e_x86_64//:modules_order",
        "@e2e_x86_64//:system_map",
        ":kernel_image_x86_64",
        ":kernel_vmlinux_x86_64",
    ],
)

build_test(
    name = "linux_source_root_package_build_test",
    targets = [
        "@e2e_linux_6_18_39//:tools/bpf/resolve_btfids/main.c",
        "@e2e_linux_6_18_39//:tools/lib/subcmd/Build.linux-bzl",
        "@e2e_linux_6_18_39//:tools/lib/subcmd/subcmd-config.c",
        "@e2e_linux_6_18_39//:tools/objtool/arch/x86/decode.c",
        "@e2e_linux_6_18_39//:tools/objtool/objtool.c",
    ],
)

test_suite(
    name = "kernel_outputs_build_test",
    tests = [
        ":kernel_outputs_aarch64_build_test",
        ":kernel_outputs_x86_64_build_test",
    ],
)
