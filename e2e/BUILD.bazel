load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@kernel_rules//:linux.bzl", "initramfs")
load(":qemu_boot_test.bzl", "qemu_boot_test", "qemu_system_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "tiny.config",
    "tiny_arm64.config",
])

qemu_system_target(
    name = "qemu_system_target",
    build_setting_default = "x86_64",
)

config_setting(
    name = "qemu_system_x86_64",
    flag_values = {
        ":qemu_system_target": "x86_64",
    },
)

config_setting(
    name = "qemu_system_aarch64",
    flag_values = {
        ":qemu_system_target": "aarch64",
    },
)

initramfs(
    name = "initramfs_x86_64",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
)

initramfs(
    name = "initramfs_aarch64",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_aarch64",
    },
)

build_test(
    name = "linux_6_12_96_build_test",
    targets = [
        "@e2e_6_12_96_aarch64//:kernel",
        "@e2e_6_12_96_x86_64//:kernel",
    ],
)

qemu_boot_test(
    name = "linux_6_12_96_x86_64_boot_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    initramfs = ":initramfs_x86_64",
    kernel = "@e2e_6_12_96_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_12_96_aarch64_boot_test",
    size = "large",
    timeout = "long",
    arch = "aarch64",
    initramfs = ":initramfs_aarch64",
    kernel = "@e2e_6_12_96_aarch64//:kernel",
    kernel_args = [
        "console=ttyAMA0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_18_39_x86_64_boot_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    initramfs = ":initramfs_x86_64",
    kernel = "@e2e_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_18_39_aarch64_boot_test",
    size = "large",
    timeout = "long",
    arch = "aarch64",
    initramfs = ":initramfs_aarch64",
    kernel = "@e2e_aarch64//:kernel",
    kernel_args = [
        "console=ttyAMA0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

alias(
    name = "kernel_image_aarch64",
    actual = "@e2e_aarch64//:image",
)

alias(
    name = "kernel_vmlinux_aarch64",
    actual = "@e2e_aarch64//:vmlinux",
)

alias(
    name = "kernel_image_x86_64",
    actual = "@e2e_x86_64//:image",
)

alias(
    name = "kernel_vmlinux_x86_64",
    actual = "@e2e_x86_64//:vmlinux",
)

build_test(
    name = "kernel_outputs_build_test",
    targets = [
        "@e2e_aarch64//:config",
        "@e2e_aarch64//:kernel",
        "@e2e_aarch64//:kernel_release",
        "@e2e_aarch64//:system_map",
        "@e2e_x86_64//:config",
        "@e2e_x86_64//:kernel",
        "@e2e_x86_64//:kernel_release",
        "@e2e_x86_64//:system_map",
        ":kernel_image_aarch64",
        ":kernel_image_x86_64",
        ":kernel_vmlinux_aarch64",
        ":kernel_vmlinux_x86_64",
    ],
)
