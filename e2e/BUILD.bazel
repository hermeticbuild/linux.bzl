# gazelle:prefix github.com/hermeticbuild/linux.bzl/e2e

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@linux.bzl", "initramfs", "linux_module")
load(":qemu_boot_test.bzl", "qemu_boot_test", "qemu_system_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "rust.config",
    "tiny.config",
    "tiny_arm64.config",
])

linux_module(
    name = "rust_test_module",
    srcs = ["rust_test_module.rs"],
    kernel = "@e2e_rust_x86_64//:kernel",
)

linux_module(
    name = "rust_test_module_6_12_96",
    srcs = ["rust_test_module_6_12.rs"],
    kernel = "@e2e_rust_6_12_96_x86_64//:kernel",
)

qemu_system_target(
    name = "qemu_system_target",
    build_setting_default = "x86_64",
)

config_setting(
    name = "qemu_system_x86_64",
    flag_values = {
        ":qemu_system_target": "x86_64",
    },
)

config_setting(
    name = "qemu_system_aarch64",
    flag_values = {
        ":qemu_system_target": "aarch64",
    },
)

initramfs(
    name = "initramfs_x86_64",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
)

initramfs(
    name = "initramfs_aarch64",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_aarch64",
    },
)

select_file(
    name = "test_module_6_12_96_x86_64",
    srcs = "@e2e_6_12_96_x86_64//:modules",
    subpath = "test_module.ko",
)

select_file(
    name = "test_module_6_12_96_aarch64",
    srcs = "@e2e_6_12_96_aarch64//:modules",
    subpath = "test_module.ko",
)

select_file(
    name = "test_module_6_18_39_x86_64",
    srcs = "@e2e_x86_64//:modules",
    subpath = "test_module.ko",
)

select_file(
    name = "test_module_6_18_39_aarch64",
    srcs = "@e2e_aarch64//:modules",
    subpath = "test_module.ko",
)

initramfs(
    name = "initramfs_6_12_96_rust_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
    files = {
        "/test_module.ko": ":rust_test_module_6_12_96",
    },
)

initramfs(
    name = "initramfs_6_12_96_x86_64_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
    files = {
        "/test_module.ko": ":test_module_6_12_96_x86_64",
    },
)

initramfs(
    name = "initramfs_6_12_96_aarch64_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_aarch64",
    },
    files = {
        "/test_module.ko": ":test_module_6_12_96_aarch64",
    },
)

initramfs(
    name = "initramfs_6_18_39_x86_64_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
    files = {
        "/test_module.ko": ":test_module_6_18_39_x86_64",
    },
)

initramfs(
    name = "initramfs_6_18_39_rust_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_x86_64",
    },
    files = {
        "/test_module.ko": ":rust_test_module",
    },
)

initramfs(
    name = "initramfs_6_18_39_aarch64_module",
    character_devices = {
        "/dev/console": "5:1",
        "/dev/null": "1:3",
    },
    executables = {
        "/init": "//boot:init_aarch64",
    },
    files = {
        "/test_module.ko": ":test_module_6_18_39_aarch64",
    },
)

qemu_boot_test(
    name = "linux_6_12_96_rust_module_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    expect = "LINUX_BZL_MODULE_LOAD_OK",
    initramfs = ":initramfs_6_12_96_rust_module",
    kernel = "@e2e_rust_6_12_96_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_12_96_x86_64_boot_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    initramfs = ":initramfs_x86_64",
    kernel = "@e2e_6_12_96_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_12_96_aarch64_boot_test",
    size = "large",
    timeout = "long",
    arch = "aarch64",
    initramfs = ":initramfs_aarch64",
    kernel = "@e2e_6_12_96_aarch64//:kernel",
    kernel_args = [
        "console=ttyAMA0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_12_96_x86_64_module_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    expect = "LINUX_BZL_MODULE_LOAD_OK",
    initramfs = ":initramfs_6_12_96_x86_64_module",
    kernel = "@e2e_6_12_96_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

