    name = "linux_6_12_96_aarch64_module_test",
    size = "large",
    timeout = "long",
    arch = "aarch64",
    expect = "LINUX_BZL_MODULE_LOAD_OK",
    initramfs = ":initramfs_6_12_96_aarch64_module",
    kernel = "@e2e_6_12_96_aarch64//:kernel",
    kernel_args = [
        "console=ttyAMA0,115200",
        "rdinit=/init",
        "panic=-1",
    ],
)

qemu_boot_test(
    name = "linux_6_18_39_x86_64_boot_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    initramfs = ":initramfs_x86_64",
    kernel = "@e2e_x86_64//:kernel",
    kernel_args = [
        "console=ttyS0,115200",
