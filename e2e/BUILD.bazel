# These load against the matching MODVERSIONS kernel, and must reject a copy
# with exactly one changed module_layout CRC before accepting the original.
qemu_boot_test(
    name = "linux_6_12_96_x86_64_modversions_module_test",
    size = "large",
    timeout = "long",
    arch = "x86_64",
    expect = "LINUX_BZL_MODVERSIONS_OK",
    initramfs = ":initramfs_6_12_96_x86_64_modversions_module",
    kernel = "@e2e_6_12_96_x86_64//variants/modversions:kernel",
    kernel_args = [
        "console=ttyS0,115200",
        "rdinit=/init",
        "panic=-1",
        "--",
        "--check-modversions",
    ],
)

