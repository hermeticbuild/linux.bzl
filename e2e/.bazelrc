import ../.bazelrc.shared

common:remote --extra_execution_platforms=@hermetic_llvm//:rbe_platform

build:compiler-clang --//:compiler=clang
build:compiler-gcc --//:compiler=gcc
build:compiler-gcc --extra_toolchains=//:gcc_cc_toolchain_aarch64
build:compiler-gcc --extra_toolchains=//:gcc_cc_toolchain_armv7
build:compiler-gcc --extra_toolchains=//:gcc_cc_toolchain_x86_64

build:map-directory-clang --config=compiler-clang
build:map-directory-gcc --config=compiler-gcc

try-import %workspace%/.bazelrc.user
