load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "x86boot_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/x86boot",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "x86boot",
    embed = [":x86boot_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "x86boot_test",
    srcs = ["main_test.go"],
    embed = [":x86boot_lib"],
)
