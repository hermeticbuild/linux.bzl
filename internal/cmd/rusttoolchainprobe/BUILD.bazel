load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "rusttoolchainprobe_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/rusttoolchainprobe",
    visibility = ["//visibility:private"],
    deps = ["//internal/rusttoolchain"],
)

go_binary(
    name = "rusttoolchainprobe",
    embed = [":rusttoolchainprobe_lib"],
    visibility = ["//internal:__subpackages__"],
)

go_test(
    name = "rusttoolchainprobe_test",
    srcs = ["main_test.go"],
    embed = [":rusttoolchainprobe_lib"],
    deps = ["//internal/rusttoolchain"],
)
