load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "kernelflags_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/kernelflags",
    visibility = ["//visibility:private"],
    deps = ["//internal/kconfig"],
)

go_binary(
    name = "kernelflags",
    embed = [":kernelflags_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "kernelflags_test",
    srcs = ["main_test.go"],
    embed = [":kernelflags_lib"],
    embedsrcs = ["main.go"],
    deps = ["//internal/kconfig"],
)
