load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "rustcrun_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/rustcrun",
    visibility = ["//visibility:private"],
    deps = ["//internal/rusttoolchain"],
)

go_binary(
    name = "rustcrun",
    embed = [":rustcrun_lib"],
    visibility = ["//internal:__subpackages__"],
)

go_test(
    name = "rustcrun_test",
    srcs = ["main_test.go"],
    embed = [":rustcrun_lib"],
    deps = ["//internal/rusttoolchain"],
)
