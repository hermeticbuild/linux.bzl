load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "scriptrun_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/scriptrun",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/toolaction",
        "//internal/toolsetpath",
    ],
)

go_binary(
    name = "scriptrun",
    embed = [":scriptrun_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "scriptrun_test",
    srcs = ["main_test.go"],
    embed = [":scriptrun_lib"],
    deps = [
        "//internal/toolaction",
        "//internal/toolsetpath",
    ],
)
