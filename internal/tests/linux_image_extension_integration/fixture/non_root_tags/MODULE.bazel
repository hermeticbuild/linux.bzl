module(
    name = "linux_image_extension_non_root_tags",
    version = "1.0.0",
)

bazel_dep(name = "linux.bzl", version = "0.1.0")
bazel_dep(name = "linux_image_tagging_dependency", version = "1.0.0")
bazel_dep(name = "llvm", version = "0.8.14")

local_path_override(
    module_name = "linux.bzl",
    path = "../linux_bzl",
)

local_path_override(
    module_name = "llvm",
    path = "../llvm",
)

local_path_override(
    module_name = "linux_image_tagging_dependency",
    path = "dependency",
)

linux_images = use_extension("@linux.bzl//:extensions.bzl", "linux_images")
use_repo(linux_images, "dependency_kernel")
