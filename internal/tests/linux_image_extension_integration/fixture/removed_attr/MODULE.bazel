module(
    name = "linux_image_extension_removed_attr",
    version = "1.0.0",
)

bazel_dep(name = "linux.bzl", version = "0.1.0")
bazel_dep(name = "llvm", version = "0.8.14")

local_path_override(
    module_name = "linux.bzl",
    path = "../linux_bzl",
)

local_path_override(
    module_name = "llvm",
    path = "../llvm",
)

linux_images = use_extension("@linux.bzl//:extensions.bzl", "linux_images")
linux_images.image(
    name = "fixture_kernel",
    arch = "x86_64",
    config = "//:base.config",
    platform = "@llvm//platforms:linux_x86_64",
    source = "//:Kconfig",
)
use_repo(linux_images, "fixture_kernel")
