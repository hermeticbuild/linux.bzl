    name = "graph_profile_record_build_test",
    targets = [":graph_profile_record_test_target"],
)

filegroup(
    name = "graph_profile_record_json",
    srcs = [":graph_profile_record_test_target"],
    output_group = "profile",
)

filegroup(
    name = "graph_profile_record_validation",
    srcs = [":graph_profile_record_test_target"],
    output_group = "validation",
)

genrule(
    name = "graph_profile_record_assert",
    srcs = [
        ":graph_profile_record_json",
        ":graph_profile_record_validation",
    ],
    outs = ["graph_profile_record_asserted"],
    cmd = """
grep -q '"kbuild_graph_probes": \\[' $(location :graph_profile_record_json)
grep -q '"kind": "cc_option"' $(location :graph_profile_record_json)
grep -q '"supported": false' $(location :graph_profile_record_json)
grep -q '^validation_scope=configured-graph$$' $(location :graph_profile_record_validation)
touch $@
""",
)

build_test(
    name = "graph_profile_record_test",
    targets = [":graph_profile_record_assert"],
)

