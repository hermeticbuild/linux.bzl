package(default_visibility = ["//visibility:private"])

toolchain_type(
    name = "rust_guard_pin_toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "rust_guard_second_pin_toolchain_type",
    visibility = ["//visibility:public"],
)

constraint_setting(name = "rust_guard_execution_slot")

constraint_value(
    name = "rust_guard_first_slot",
    constraint_setting = ":rust_guard_execution_slot",
)

constraint_value(
    name = "rust_guard_second_slot",
    constraint_setting = ":rust_guard_execution_slot",
)

constraint_value(
    name = "rust_guard_fallback_slot",
    constraint_setting = ":rust_guard_execution_slot",
)

platform(
    name = "rust_guard_first_platform",
    allowed_toolchain_types = [
        ":rust_guard_pin_toolchain_type",
        "@rules_rs//rs:bindgen_toolchain_type",
        "@rules_rust//rust:toolchain_type",
        "@rules_rust//rust/rust_analyzer:toolchain_type",
    ],
    check_toolchain_types = True,
    constraint_values = [
        ":rust_guard_first_slot",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "rust_guard_second_platform",
    allowed_toolchain_types = [
        ":rust_guard_second_pin_toolchain_type",
        "@rules_rs//rs:bindgen_toolchain_type",
        "@rules_rust//rust:toolchain_type",
        "@rules_rust//rust/rust_analyzer:toolchain_type",
