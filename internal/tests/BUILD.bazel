    check_toolchain_types = True,
    constraint_values = [
        ":rust_guard_second_slot",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "rust_guard_fallback_platform",
    constraint_values = [
        ":rust_guard_fallback_slot",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

