load(":defs.bzl", "kernel_execution_tools", "kernel_execution_tools_check")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

kernel_execution_tools_check(
    name = "check",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

kernel_execution_tools(
    name = "linux_x86_64_tools",
    build_commands = {
        "@ape//ape:find": "find",
        "@kernel_exec_busybox_linux_x86_64//file": "bc hexdump xargs diff lzop cpio which",
        # The executable selects the legacy CLI from its invocation name.
        "@lz4//programs:lz4": "lz4 lz4c",
    },
    commands = {
        "@kernel_exec_bash_linux_x86_64//file": "sh bash",
        "@kernel_exec_busybox_linux_x86_64//file": "cmp",
        "@gawk//:gawk": "awk",
        "@sed//:sed": "sed",
        "@grep//:grep": "grep",
        "@make//:make": "make",
    },
    coreutils = "[ basename cat chmod cp cut date dd dirname echo env expr false head install ln ls mkdir mktemp mv od printf pwd readlink realpath rm seq sha1sum sleep sort stat tail test touch tr true uname uniq wc".split(" "),
)

toolchain(
    name = "linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":linux_x86_64_tools",
    toolchain_type = ":toolchain_type",
)
