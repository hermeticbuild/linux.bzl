load("@autoconf_prototype//:autoconf.bzl", "autoconf", "compile_test")
load("@bazel_skylib//rules/directory:subdirectory.bzl", "subdirectory")
load("@kernel_inputs//rules:qualification.bzl", "FRAGMENTS")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_python//python:defs.bzl", "py_test")
load("//rules:compiler.bzl", "kernel_compiler")
load("//rules:compiler_test.bzl", "action_built_compiler", "action_built_toolchain_config")
load("//rules:kernel.bzl", "kernel_build")
load("//rules:options.bzl", "kernel_bool")
load("//rules:parity.bzl", "configured_report", "kernel_parity")

exports_files([
    "probe_runtime.py",
    "compare_upstream.py",
    "execute.py",
    "scheduler.py",
    "emit.py",
])

kernel_build(
    name = "kernel",
    rounds = 64,
)

kernel_build(
    name = "config",
    config_only = True,
    rounds = 0,
)

kernel_build(
    name = "allno_config",
    config_only = True,
    mode = "allno",
    rounds = 0,
)

kernel_build(
    name = "debug_config",
    config_only = True,
    requested = {
        "DEBUG_KERNEL": "y",
        "DEBUG_INFO_DWARF5": "y",
        "DEBUG_INFO_NONE": "n",
        "PRINTK_TIME": "y",
    },
    rounds = 0,
)

autoconf(
    name = "custom_probes",
    tests = {"HAVE_CUSTOM_INT128": compile_test(
        "int f(void) { __int128 x = 0; return (int)x; }",
        flags = ["-Werror"],
    )},
)

kernel_build(
    name = "custom_config",
    config_only = True,
    extra_records = [
        json.encode(kernel_bool(
            "AUTOCONF_PROTOTYPE_CUSTOM",
            default = "HAVE_CUSTOM_INT128",
            probe = True,
        )),
        json.encode(kernel_bool(
            "AUTOCONF_PROTOTYPE_DEPENDENT",
            default = "y",
            depends = "AUTOCONF_PROTOTYPE_CUSTOM",
        )),
    ],
    probes = ":custom_probes",
    rounds = 0,
)

py_test(
    name = "execute_test",
    srcs = [
        "execute.py",
        "test_execute.py",
    ],
    main = "test_execute.py",
)

py_test(
    name = "configure_test",
    srcs = [
        "configure.py",
        "test_configure.py",
    ],
    main = "test_configure.py",
)

config_setting(
    name = "clang",
    flag_values = {"@rules_cc//cc/compiler:compiler": "clang"},
)

LLVM_TOOLS = {
    "@llvm//tools:clang": "CC",
    "@llvm//tools:clang++": "CXX",
    "@llvm//tools:ld.lld": "LD",
    "@llvm//tools:llvm-ar": "AR",
    "@llvm//tools:llvm-nm": "NM",
    "@llvm//tools:llvm-objcopy": "OBJCOPY",
    "@llvm//tools:llvm-objdump": "OBJDUMP",
    "@llvm//tools:llvm-readelf": "READELF",
    "@llvm//tools:llvm-strip": "STRIP",
}

subdirectory(
    name = "llvm_builtin_headers",
    parent = "@llvm//:builtin_resource_dir",
    path = "include",
    tags = ["manual"],
)

kernel_compiler(
    name = "compiler",
    assembler_flags = select({
        ":clang": ["-fintegrated-as"],
        "//conditions:default": [],
    }),
    builtin_headers = select({
        ":clang": ":llvm_builtin_headers",
        "//conditions:default": None,
    }),
    tools = select({
        ":clang": LLVM_TOOLS,
        "//conditions:default": {"@host_tools//:bin/readelf": "READELF"},
    }),
    visibility = ["//visibility:public"],
)

kernel_compiler(
    name = "llvm_compiler",
    assembler_flags = ["-fintegrated-as"],
    builtin_headers = ":llvm_builtin_headers",
    tags = ["manual"],
    tools = LLVM_TOOLS,
)

kernel_build(
    name = "llvm_config",
    compiler = ":llvm_compiler",
    config_only = True,
    rounds = 0,
    tags = ["manual"],
)

[
    kernel_build(
        name = "qualification_" + name,
        config_only = True,
        mode = "qualification",
        requested = dict(FRAGMENTS["x86_64"].items() + FRAGMENTS[name].items()) if name != "aarch64" else FRAGMENTS[name],
        rounds = 0,
        tags = ["manual"] if name == "aarch64" else [],
    )
    for name in [
        "x86_64",
        "debug",
        "lz4",
        "btf",
        "aarch64",
    ]
]

py_test(
    name = "probes_test",
    srcs = [
        "probe_runtime.py",
        "test_probes.py",
    ],
    args = [
        "--compiler",
        "$(location @host_tools//:bin/gcc)",
    ],
    data = ["@host_tools//:bin/gcc"],
    main = "test_probes.py",
)

[
    kernel_parity(
        name = "parity_report_" + name,
        kernel = ":qualification_" + name,
        tags = ["manual"] if name == "aarch64" else [],
    )
    for name in [
        "x86_64",
        "debug",
        "lz4",
        "btf",
        "aarch64",
    ]
]

[
    py_test(
        name = "parity_" + name + "_test",
        srcs = ["test_parity.py"],
        args = ["$(location :parity_report_" + name + ")"],
        data = [":parity_report_" + name],
        main = "test_parity.py",
        tags = ["manual"],
    )
    for name in [
        "x86_64",
        "debug",
        "lz4",
        "btf",
        "aarch64",
    ]
]

# A compiler output built in this same invocation, isolated from its host toolchain.
constraint_setting(name = "compiler_origin")

constraint_value(
    name = "action_built",
    constraint_setting = ":compiler_origin",
)

platform(
    name = "action_built_platform",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":action_built",
    ],
)

action_built_compiler(
    name = "compiler_driver",
    src = "//tests:compiler_driver.c",
    tags = ["manual"],
)

action_built_toolchain_config(
    name = "driver_toolchain_config",
    driver = ":compiler_driver",
    tags = ["manual"],
)

cc_toolchain(
    name = "driver_cc_toolchain",
    all_files = ":compiler_driver",
    ar_files = ":compiler_driver",
    as_files = ":compiler_driver",
    compiler_files = ":compiler_driver",
    dwp_files = ":compiler_driver",
    linker_files = ":compiler_driver",
    objcopy_files = ":compiler_driver",
    strip_files = ":compiler_driver",
    supports_param_files = 0,
    tags = ["manual"],
    toolchain_config = ":driver_toolchain_config",
    toolchain_identifier = "action-built-compiler-test",
)

toolchain(
    name = "driver_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = ["manual"],
    target_compatible_with = [
        ":action_built",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":driver_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

configured_report(
    name = "action_built_report",
    platform = ":action_built_platform",
    report = ":parity_report_x86_64",
    tags = ["manual"],
)

py_test(
    name = "action_built_parity_test",
    srcs = ["test_parity.py"],
    args = [
        "$(location :action_built_report)",
        "--compiler-suffix",
        "/compiler_driver",
    ],
    data = [":action_built_report"],
    main = "test_parity.py",
    tags = ["manual"],
)

configured_report(
    name = "arm64_report",
    platform = "@llvm//platforms:linux_aarch64",
    report = ":parity_report_aarch64",
    tags = ["manual"],
)

py_test(
    name = "arm64_parity_test",
    srcs = ["test_parity.py"],
    args = ["$(location :arm64_report)"],
    data = [":arm64_report"],
    main = "test_parity.py",
    tags = ["manual"],
)

py_test(
    name = "reuse_report_test",
    srcs = [
        "check_reuse.py",
        "test_reuse.py",
    ],
    main = "test_reuse.py",
)
