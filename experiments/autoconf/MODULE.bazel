module(
    name = "linux_bzl_autoconf_example",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "autoconf.bzl", version = "0.0.0")
git_override(
    module_name = "autoconf.bzl",
    commit = "08d970e04ac0592179d7b832e3189ae39a4e042c",
    remote = "https://github.com/hermeticbuild/autoconf.bzl.git",
)

include("//:.generated/setup.MODULE.bazel")

host = use_repo_rule("//:host_repo.bzl", "host_repository")

host(
    name = "host_tools",
    linux = "@linux_source//:Makefile",
)
