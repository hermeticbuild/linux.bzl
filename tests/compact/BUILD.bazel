genrule(
    name = "shared_object_variant_check",
    srcs = [":golden_metadata"],
    outs = ["shared_object_variant_check.txt"],
    cmd = "$(location //internal/cmd/compact_metadata_check) " +
          "-metadata $(location :golden_metadata) " +
          "-share base:blocked_driver:init.o " +
          "-share base:debug:init.o " +
          "-differ base:force_net:init.o " +
          "-absent base:debug.o " +
          "-present debug:debug.o > $@",
    tools = ["//internal/cmd/compact_metadata_check"],
)

build_test(
    name = "shared_object_variant_check_test",
    targets = [":shared_object_variant_check"],
)

genrule(
    name = "content_addressed_check",
    srcs = [":content_addressed_metadata"],
    outs = ["content_addressed_check.txt"],
    cmd = "$(location //internal/cmd/compact_metadata_check) " +
          "-metadata $(location :content_addressed_metadata) " +
          "-require_content_ids " +
          "-summary " +
          "-max_object_variants 5 " +
          "-share base:blocked_driver:init.o " +
          "-share base:debug:init.o " +
          "-differ base:force_net:init.o " +
          "-absent base:debug.o " +
          "-present debug:debug.o > $@",
    tools = ["//internal/cmd/compact_metadata_check"],
)

build_test(
    name = "content_addressed_check_test",
    targets = [":content_addressed_check"],
)

