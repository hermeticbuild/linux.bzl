load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//internal:compact_generator.bzl", "linux_compact_buildfiles")
load("//internal:linux_objects.bzl", "linux_config")

package(default_visibility = ["//:__subpackages__"])

linux_config(
    name = "source_config",
    config_flags = {},
)

linux_compact_buildfiles(
    name = "golden",
    srcs = [
        "debug.c",
        "drivers/foo.c",
        "init.c",
        "net/core.c",
    ],
    configs = {
        "base.config": "base",
        "blocked_driver.config": "blocked_driver",
        "debug.config": "debug",
        "force_net.config": "force_net",
    },
    kbuild = "Kbuild",
    linux_objects_load = "@linux.bzl//internal:linux_objects.bzl",
    object_label_package = "tests/compact/objects",
    out_buildfile = "expected.BUILD.bazel",
    out_metadata = "expected.metadata.golden",
    root = "Kconfig",
    source_config = "//tests/compact:source_config",
    source_generated_includes_complete = True,
    source_label_package = "//tests/compact",
    source_root_label = "//tests/compact:Kconfig",
)

genrule(
    name = "shared_object_variant_check",
    srcs = [":golden_metadata"],
    outs = ["shared_object_variant_check.txt"],
    cmd = "$(location //internal/cmd/compact_metadata_check) " +
          "-metadata $(location :golden_metadata) " +
          "-share base:blocked_driver:init.o " +
          "-share base:debug:init.o " +
          "-differ base:force_net:init.o " +
          "-absent base:debug.o " +
          "-present debug:debug.o > $@",
    tools = ["//internal/cmd/compact_metadata_check"],
)

build_test(
    name = "shared_object_variant_check_test",
    targets = [":shared_object_variant_check"],
)
