obj-$(CONFIG_MAP_DIRECTORY_CC_SUPPORTED) += supported.o
obj-$(CONFIG_MAP_DIRECTORY_CC_UNSUPPORTED) += unsupported.o
obj-$(CONFIG_MAP_DIRECTORY_CLANG_SELECTED) += clang_selected.o
obj-$(CONFIG_MAP_DIRECTORY_GCC_SELECTED) += gcc_selected.o

CFLAGS_supported.o += -fno-omit-frame-pointer -DMAP_DIRECTORY_RECIPE_REPLAYED=1
CFLAGS_clang_selected.o += -DMAP_DIRECTORY_CLANG_RECIPE_REPLAYED=1
CFLAGS_gcc_selected.o += -DMAP_DIRECTORY_GCC_RECIPE_REPLAYED=1
