load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_go//go:def.bzl", "go_binary")
load(
    "//internal:map_directory_kconfig.bzl",
    "linux_map_directory_gcc_kconfig_spike",
    "linux_map_directory_kconfig_spike",
    "linux_upstream_gcc_kconfig_test",
    "map_directory_probe_identity_comparison",
)

package(default_visibility = ["//visibility:private"])

bool_flag(
    name = "use_gcc_toolchain",
    build_setting_default = False,
)

config_setting(
    name = "gcc_toolchain_selected",
    flag_values = {":use_gcc_toolchain": "true"},
)

toolchain(
    name = "gcc_cc_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_settings = [":gcc_toolchain_selected"],
    toolchain = "@map_directory_gcc_x86_64//:_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

go_binary(
    name = "validator",
    srcs = ["validator.go"],
    pure = "on",
    deps = ["//internal/kconfig"],
)

go_binary(
    name = "upstream_validator",
    srcs = ["upstream_validator.go"],
    pure = "on",
)

linux_map_directory_kconfig_spike(
    name = "compiler_capabilities",
    srcs = [
        "clang_selected.c",
        "gcc_selected.c",
        "include/linux/compiler-version.h",
        "include/linux/compiler_types.h",
        "include/linux/kconfig.h",
        "required_local_header.h",
        "supported.c",
        "unsupported.c",
    ],
    config = "base.config",
    kbuild = "Kbuild",
    kconfig = "Kconfig",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    validator = ":validator",
)

linux_map_directory_gcc_kconfig_spike(
    name = "gcc_compiler_capabilities",
    srcs = [
        "clang_selected.c",
        "gcc_selected.c",
        "include/linux/compiler-version.h",
        "include/linux/compiler_types.h",
        "include/linux/kconfig.h",
        "required_local_header.h",
        "supported.c",
        "unsupported.c",
    ],
    config = "base.config",
    kbuild = "Kbuild",
    kconfig = "Kconfig",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    validator = ":validator",
)

linux_upstream_gcc_kconfig_test(
    name = "upstream_gcc_kconfig",
    config = "@map_directory_linux_6_18_39//:arch/x86/configs/x86_64_defconfig",
    kconfig = "@map_directory_linux_6_18_39//:Kconfig",
    kconfig_files = "@map_directory_linux_6_18_39//:kconfig_files",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    validator = ":upstream_validator",
)

filegroup(
    name = "clang_plan",
    srcs = [":compiler_capabilities"],
    output_group = "plan",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
)

filegroup(
    name = "gcc_plan",
    srcs = [":gcc_compiler_capabilities"],
    output_group = "plan",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
)

map_directory_probe_identity_comparison(
    name = "distinct_compiler_plan_identities",
    first = ":clang_plan",
    second = ":gcc_plan",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    validator = ":validator",
)

build_test(
    name = "compiler_capabilities_e2e_test",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    targets = [":compiler_capabilities"],
)

build_test(
    name = "gcc_compiler_capabilities_e2e_test",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    targets = [":gcc_compiler_capabilities"],
)

build_test(
    name = "upstream_gcc_kconfig_e2e_test",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    targets = [":upstream_gcc_kconfig"],
)

build_test(
    name = "distinct_compiler_plan_identities_e2e_test",
    tags = [
        "manual",
        "requires-bazel-9",
    ],
    targets = [":distinct_compiler_plan_identities"],
)
